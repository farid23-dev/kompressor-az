rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Cars collection ────────────────────────────────────────────────────────
    match /cars/{carId} {

      // Any authenticated user can read listings
      allow read: if request.auth != null;

      // Only the seller can create a listing, and they must set sellerUid to themselves
      allow create: if request.auth != null
                    && request.resource.data.sellerUid == request.auth.uid;

      // Only the original seller can update or delete their own listing
      allow update, delete: if request.auth != null
                             && resource.data.sellerUid == request.auth.uid;
    }

    // ── Deny everything else by default ───────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
