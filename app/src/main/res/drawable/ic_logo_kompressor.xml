    <path android:fillColor="#FFF176" android:pathData="M30,58 L20,65 L30,65 Z"/>
    <!-- Tail light -->
    <path android:fillColor="#EF9A9A" android:pathData="M262,60 L272,67 L262,67 Z"/>

    <!-- "KOMPRESSOR" text — bold purple -->
    <path android:fillColor="#7B2FBE"
        android:pathData="M290,22 L300,22 L300,68 L290,68 Z
