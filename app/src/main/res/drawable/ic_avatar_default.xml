<?xml version="1.0" encoding="utf-8"?>
<!--
    Default user avatar — person silhouette.
    Uses ?attr/colorControlNormal so it renders correctly in both light and dark themes.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- Head (circle via arc path: cx=24, cy=16, r=9) -->
    <path
        android:fillColor="?attr/colorControlNormal"
        android:pathData="M15,16
            A9,9 0 1 0 33,16
            A9,9 0 1 0 15,16 Z"/>

    <!-- Shoulders / body area -->
    <path
        android:fillColor="?attr/colorControlNormal"
        android:pathData="M8,42 C8,32 14,27 24,27 C34,27 40,32 40,42 Z"/>

</vector>
