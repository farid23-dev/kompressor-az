rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Car images — any signed-in user can upload, anyone can read (for listing display)
    match /car_images/{uid}/{allPaths=**} {
      allow read:  if true;
      allow write: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
