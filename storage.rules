rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Car images: authenticated users can read, only the uploader can write/delete.
    // Path convention: car_images/{uid}/{filename}
    match /car_images/{uid}/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
